# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Required. Valio Aimo mock-API key: Junction platform -> challenge "Trusted Trade Agents" -> Resources
# (also on page 4 of the challenge PDF). Ask a teammate if you cannot access it.
AIMO_API_KEY=

# Optional. Gemini takes precedence when configured and uses the Python standard library.
# GEMINI_API_KEY=

# Optional. Enables the Claude-based request parser (also needs: pip install -r requirements.txt).
# Without it the deterministic rule parser is used.
# ANTHROPIC_API_KEY=
